# Database & Cache
DATABASE_URL="postgresql://user:password@localhost:5432/taqtix_db?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT Auth & QR Signing Secrets
JWT_ACCESS_SECRET="super-secret-access-token-key-change-me"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-me"
QR_SIGNING_SECRET="super-secret-qr-key-change-me"          # secret KHUSUS untuk sign QR, beda dari JWT auth

# Payment Gateway: DOKU (Primer) & Fallback
DOKU_CLIENT_ID="your-doku-client-id"
DOKU_SECRET_KEY="your-doku-secret-key"
PAYMENT_PROVIDER_KEY="your-payment-provider-key"
PAYMENT_PROVIDER_SECRET="your-payment-provider-secret"
TAQTIX_MIDTRANS_SERVER_KEY="your-midtrans-server-key"
TAQTIX_MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
TAQTIX_MIDTRANS_IS_PRODUCTION=false

# WhatsApp Integration (Meta Cloud API / Fonnte / Wablas)
WA_PROVIDER_API_KEY="your-whatsapp-gateway-token"

# File Storage LOKAL di server (bukan S3/cloud)
UPLOAD_STORAGE_PATH=/var/www/taqtix-uploads
UPLOAD_PUBLIC_BASE_URL=https://api.taqtix.id/uploads

# App Settings & URLs
PORT=3001
TAQTIX_API_URL="https://api.taqtix.id/v1"
TAQTIX_BASE_URL="https://api.taqtix.id"
TAQTIX_WEB_URL="https://taqtix.id"
TAQTIX_FRONTEND_URL="https://taqtix.id"
TAQTIX_EO_URL="https://partner.taqtix.id"
TAQTIX_ADMIN_URL="https://core.taqtix.id"
