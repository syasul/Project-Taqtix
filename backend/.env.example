# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/taqtix_db?schema=public"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT Auth Secrets
TAQTIX_JWT_ACCESS_SECRET="super-secret-access-token-key-change-me"
TAQTIX_JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-me"
QR_SECRET="super-secret-qr-key-change-me"

# Midtrans Payment Gateway
TAQTIX_MIDTRANS_SERVER_KEY="your-midtrans-server-key"
TAQTIX_MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
TAQTIX_MIDTRANS_IS_PRODUCTION=false

# App Settings
PORT=3001
TAQTIX_API_URL="https://api.taqtix.id/v1"
TAQTIX_BASE_URL="https://api.taqtix.id"
TAQTIX_WEB_URL="https://taqtix.id"
TAQTIX_FRONTEND_URL="https://taqtix.id"
TAQTIX_EO_URL="https://partner.taqtix.id"
TAQTIX_ADMIN_URL="https://core.taqtix.id"

# WhatsApp integration
TAQTIX_WA_TOKEN="your-whatsapp-gateway-token"
