  // Hal ini merupakan konfigurasi database engine menggunakan PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Hal ini menghasilkan Prisma Client untuk digunakan di NestJS
generator client {
  provider = "prisma-client-js"
}

// --- ENUMS ---

/// Status pesanan tiket pembeli.
enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

/// Status e-ticket individual.
enum TicketStatus {
  VALID
  CHECKED_IN
  CANCELLED
}

/// Status pembayaran transaksi.
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

/// Status kelayakan event.
enum EventStatus {
  DRAFT
  PUBLISHED
  ENDED
  CANCELLED
}

/// Tipe mitra afiliasi distributor tiket.
enum PartnerType {
  AMBASSADOR
  COMMUNITY
  INFLUENCER
  CORPORATE
}

// --- MODELS ---

/// Model User untuk otentikasi dan identifikasi role global.
model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  role         String      // 'buyer' | 'organizer' | 'gate_staff' | 'partner' | 'admin'
  activeDeviceId String?
  lastLoginAt    DateTime?
  lastLogoutAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  organizer            Organizer?
  organizerMembers     OrganizerMember[]
  orders               Order[]
  checkedTickets       Ticket[]           @relation("CheckedByRelation")
  checkedOutTickets    Ticket[]           @relation("CheckedOutByRelation")
  gateStaffAssignments GateStaff[]
  scanLogs             ScanLog[]
}

/// Profil tambahan bagi user dengan role 'organizer'.
model Organizer {
  id             String            @id @default(uuid())
  userId         String            @unique
  name           String
  slug           String            @unique
  bankAccount    String?           // Informasi rekening bank organizer untuk pembayaran
  segment        String?           // "event_builder" | "event_ip_owner" | "campus_community" | "enterprise"
  plan           String            @default("starter") // "starter" | "pro" | "enterprise"
  planStartedAt  DateTime?
  planExpiresAt  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         Event[]
  members        OrganizerMember[]
}

/// Representasi dari suatu Event / Acara.
model Event {
  id               String            @id @default(uuid())
  organizerId      String
  title            String
  slug             String            @unique
  description      String?           @db.Text
  bannerUrl        String            @default("")
  location         String
  startDate        DateTime
  endDate          DateTime
  status           EventStatus       @default(DRAFT)
  geofenceLat      Float?
  geofenceLng      Float?
  geofenceRadius   Float?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organizer        Organizer         @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  ticketCategories TicketCategory[]
  orders           Order[]
  promoCodes       PromoCode[]
  partners         Partner[]
  gateStaffs       GateStaff[]
  workforceMembers WorkforceMember[]
  tickets          Ticket[]
  segments         Segment[]
  adSpends         AdSpend[]
  trackEvents      TrackEvent[]
}

/// Kategori/Tipe Tiket yang tersedia pada suatu event.
model TicketCategory {
  id          String   @id @default(uuid())
  eventId     String
  name        String
  price       Float
  quota       Int
  sold        Int      @default(0)
  maxPerOrder Int      @default(5)
  saleStartAt DateTime
  saleEndAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
}

/// Model Order transaksi pembelian tiket.
model Order {
  id             String            @id @default(uuid())
  eventId        String
  buyerId        String
  totalAmount    Float
  discountAmount Float             @default(0.0)
  status         OrderStatus       @default(PENDING)
  promoCodeId    String?
  partnerId      String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  createdAt      DateTime          @default(now())
  expiredAt      DateTime
  updatedAt      DateTime          @updatedAt

  event          Event             @relation(fields: [eventId], references: [id])
  buyer          User              @relation(fields: [buyerId], references: [id])
  promoCode      PromoCode?        @relation(fields: [promoCodeId], references: [id])
  partner        Partner?          @relation(fields: [partnerId], references: [id])
  orderItems     OrderItem[]
  payment        Payment?
}

/// Rincian item tiket di dalam satu pemesanan / Order.
model OrderItem {
  id               String         @id @default(uuid())
  orderId          String
  ticketCategoryId String
  qty              Int
  unitPrice        Float
  attendeeName     String
  attendeeEmail    String
  attendeePhone    String
  city             String?
  createdAt        DateTime       @default(now())

  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketCategory   TicketCategory @relation(fields: [ticketCategoryId], references: [id])
  tickets          Ticket[]
}

/// Lembaran tiket fisik digital (e-ticket) yang sah untuk check-in.
model Ticket {
  id           String       @id @default(uuid())
  orderItemId  String
  eventId      String
  qrPayload    String       @unique // Signed JWT format
  status       TicketStatus @default(VALID)
  checkedInAt  DateTime?
  checkedInBy  String?
  checkedOutAt DateTime?
  checkedOutBy String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staff        User?        @relation("CheckedByRelation", fields: [checkedInBy], references: [id])
  checkedOutStaff User?     @relation("CheckedOutByRelation", fields: [checkedOutBy], references: [id])
  scanLogs     ScanLog[]
}

/// Log transaksi pembayaran via payment gateway.
model Payment {
  id         String        @id @default(uuid())
  orderId    String        @unique
  provider   String        @default("midtrans") // "midtrans" | "xendit"
  snapToken  String?       // Token Snap Midtrans
  externalId String?       // Referensi kode transaksi dari Midtrans/Xendit (gatewayRef)
  amount     Float
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// Kode promo diskon harga tiket yang dibuat oleh organizer.
model PromoCode {
  id        String   @id @default(uuid())
  eventId   String
  code      String   @unique
  discount  Float    // Persentase atau nominal diskon
  maxUsage  Int
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders    Order[]
}

/// Partner afiliasi yang membantu penjualan tiket event.
model Partner {
  id               String      @id @default(uuid())
  eventId          String
  name             String
  type             PartnerType
  uniqueCode       String      @unique
  promoCode        String?     // Kode promo khusus yang diasosiasikan dengan partner
  commissionType   String      @default("percentage") // "percentage" | "fixed"
  commissionValue  Float       @default(10.0)
  clicks           Int         @default(0)
  conversions      Int         @default(0)
  revenueGenerated Float       @default(0.0)
  commissionEarned Float       @default(0.0)
  email            String?     @unique
  passwordHash     String?
  lastLoginAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  event            Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders           Order[]
  clicksList       Click[]
}

/// Log pelacakan klik link afiliasi oleh pengunjung (utm tracking).
model Click {
  id        String   @id @default(uuid())
  partnerId String
  utmSource String?
  utmMedium String?
  clickedAt DateTime @default(now())
  ipHash    String   // Hash IP address pengunjung untuk deduplikasi klik

  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

// Penugasan staff pintu masuk untuk melakukan check-in tiket
model GateStaff {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  gateName  String
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// Log validasi/scan tiket masuk untuk check-in
model ScanLog {
  id          String   @id @default(uuid())
  ticketId    String
  scannedById String
  result      String   // VALID, DUPLICATE, INVALID
  scannedAt   DateTime @default(now())
  synced      Boolean  @default(true)

  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  scannedBy   User     @relation(fields: [scannedById], references: [id], onDelete: Cascade)
}

// Model untuk Workforce Member (Phase 2 Operate)
model WorkforceMember {
  id              String    @id @default(uuid())
  eventId         String
  name            String
  phone           String
  division        String
  role            String
  shiftId         String
  picUserId       String?   // ID dari OrganizerMember
  qrPayload       String
  status          String    // "not_checked_in" | "present" | "late" | "checked_out"
  checkedInAt     DateTime?
  checkedInMethod String?   // "gate_scan" | "self_service"
  addedBy         String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model OrganizerMember {
  id          String    @id @default(uuid())
  organizerId String
  userId      String?
  email       String
  role        String    // "owner" | "admin" | "finance" | "marketing" | "viewer"
  status      String    @default("pending") // "pending" | "active" | "removed"
  inviteToken String?   @unique
  invitedBy   String
  invitedAt   DateTime  @default(now())
  joinedAt    DateTime?
  removedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizerId, email])
}

model Segment {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  criteria  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model AdSpend {
  id          String   @id @default(uuid())
  eventId     String
  channel     String   // "meta_ads" | "tiktok_ads" | "google_ads" | "other"
  amount      Float
  periodStart DateTime
  periodEnd   DateTime
  inputBy     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EnterpriseLead {
  id               String   @id @default(uuid())
  name             String
  organizationName String
  email            String
  phone            String
  message          String
  status           String   @default("new") // "new" | "contacted" | "negotiating" | "onboarded" | "not_interested"
  assignedTo       String?  // admin user id
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PartnerMagicLink {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model BroadcastJob {
  id          String               @id @default(uuid())
  segmentId   String
  message     String
  status      String               @default("queued") // "queued" | "processing" | "completed" | "failed"
  targetCount Int                  @default(0)
  sentCount   Int                  @default(0)
  failedCount Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  recipients  BroadcastRecipient[]
}

model BroadcastRecipient {
  id        String       @id @default(uuid())
  jobId     String
  name      String
  email     String
  phone     String
  status    String       @default("pending") // "pending" | "sent" | "failed"
  error     String?
  sentAt    DateTime?
  createdAt DateTime     @default(now())

  job       BroadcastJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model TrackEvent {
  id        String   @id @default(uuid())
  eventId   String
  type      String   // "page_view" | "checkout_start"
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}


